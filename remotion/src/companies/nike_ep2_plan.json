"lines": [
[
0.2,
"次の会社の物語も、このチャンネルで"
],
[
3.76,
"リクエストはコメント欄へ"
],
[
7.81,
"チャンネル登録をよろしくお願いします"
]
]
}
],
"subs": [
[
0.0,
2.984,
"1962年、日本の神戸。"
],
[
2.984,
7.244,
"一通の紹介も、実績もない24歳のアメリカ人青年が、"
],
[
7.244,
10.291,
"靴会社の重役たちの前に座っていた。"
],
[
10.291,
12.562,
"「ブルー・リボン・スポーツ社の代表です」"
],
[
12.562,
14.008,
"彼はそう名乗った。"
],
[
14.008,
16.419,
"だが、その会社は存在しない。"
],
[
16.419,
18.952,
"その場で咄嗟に考えた名前だった。"
],
[
18.952,
21.467,
"ところが、この嘘が通ってしまう。"
],
[
21.467,
25.356,
"彼は日本の運動靴のアメリカでの販売権を手に入れて、"
],
[
25.356,
26.906,
"帰国の途についた。"
],
[
26.906,
29.239,
"世界最大のスポーツブランド、ナイキ。"
],
[
29.239,
33.063,
"最新の年商は約7.3兆円。"
],
[
33.063,
35.712,
"約190の国と地域で売られ、"
],
[
35.712,
38.322,
"自社の店だけでも988店。"
],
[
38.322,
41.496,
"その帝国の出発点は、この神戸の会議室での、"
],
[
41.496,
43.157,
"1つの名乗りだった。"
],
[
43.157,
46.399,
"だが今日たどるのは、成功の記録だけではない。"
],
[
46.399,
50.042,
"この会社は、いま史上最大の危機の只中にある。"
],
[
50.042,
51.862,
"そして見ていくと分かる。"
],
[
51.862,
53.972,
"危機の種は、失敗の中ではなく、"
],
[
53.972,
56.132,
"成功のど真ん中に蒔かれていた。"
],
[
58.502,
61.033,
"まずは、その靴会社の話から。"
],
[
61.033,
62.859,
"終戦直後の神戸。"
],
[
62.859,
67.242,
"1949年、鬼塚喜八郎は資本金30万円、"
],
[
67.242,
71.117,
"社員2名で鬼塚株式会社を設立した。"
],
[
71.117,
73.377,
"戦後の青少年の健全な育成を掲げ、"
],
[
73.377,
76.211,
"本格的なスポーツシューズを作り始める。"
],
[
76.211,
78.318,
"これが、のちのアシックスである。"
],
[
78.318,
82.711,
"1962年、その神戸に現れたのが、フィル・ナイト、"
],
[
82.711,
83.564,
"24歳。"
],
[
83.564,
85.468,
"オレゴン大学で陸上を走り、"
],
[
85.468,
88.103,
"スタンフォードで経営学を学んだ彼は、"
],
[
88.103,
90.889,
"大学の論文で奇妙な仮説を立てていた。"
],
[
90.889,
93.79,
"「日本製のカメラがドイツ製を駆逐したように、"
],
[
93.79,
97.765,
"日本製のランニングシューズはドイツの強豪に勝てるはずだ」。"
],
[
97.765,
101.163,
"彼はその仮説を、自分の足で確かめに来た。"
],
[
101.163,
104.151,
"そして会議室で、存在しない会社を名乗った。"
],
[
104.151,
106.084,
"大事なのは、その後である。"
],
[
106.084,
108.923,
"ナイトは嘘を、嘘のままにしなかった。"
],
[
108.923,
112.067,
"帰国した彼は、本当に会社を作ろうとする。"
],
[
112.067,
116.086,
"注文したサンプル12足が届くまでには1年以上かかったが、"
],
[
116.086,
117.234,
"そのうち2足を、"
],
[
117.234,
121.547,
"大学時代の恩師で陸上部コーチのビル・バウワーマンに送った。"
],
[
121.547,
124.364,
"返ってきたのは、思いがけない提案だった。"
],
[
124.364,
126.268,
"「一緒に会社をやらないか」。"
],
[
126.268,
131.205,
"1964年1月25日、2人は握手を交わす。"
],
[
131.205,
133.365,
"出資は1人500ドルずつ。"
],
[
133.365,
135.631,
"ブルー・リボン・スポーツが正式に生まれた。"
],
[
135.631,
139.907,
"初回の発注は300足、1足3.33ドル。"
],
[
139.907,
142.79,
"靴が届くと、ナイトは陸上の競技会を回り、"
],
[
142.79,
145.39,
"愛車のトランクを開けて靴を売った。"
],
[
145.39,
148.504,
"世界最大のスポーツブランドの最初の店舗は、"
],
[
148.504,
150.137,
"車のトランクである。"
],
[
150.137,
152.221,
"初年度の売上は8,000ドル。"
],
[
152.221,
154.313,
"みじめで、完璧なスタートだった。"
],
[
154.313,
156.411,
"商売の原則が、ここにある。"
],
[
156.411,
159.232,
"先に名乗り、後から本物にする。"
],
[
159.232,
161.948,
"順番が逆なのではないかと思うかもしれない。"
],
[
161.948,
165.043,
"だが彼は、名乗った責任を果たす側に回った。"
],
[
165.043,
167.2,
"嘘を本物に変える作業こそが、"
],
[
167.2,
169.662,
"この会社の創業そのものだった。"
],
[
169.662,
171.357,
"順調に見えた船出。"
],
[
171.357,
174.7,
"だが、仕入れ先のオニツカから届く次の通告が、"
],
[
174.7,
176.422,
"すべてを壊しにかかる。"
],
[
178.792,
180.031,
"商売は伸びた。"
],
[
180.031,
182.933,
"コーチのバウワーマンはオニツカの靴を改造し、"
],
[
182.933,
185.722,
"名作「コルテッツ」の原型まで生み出した。"
],
[
185.722,
189.48,
"だが1971年、関係は壊れる。"
],
[
189.48,
190.397,
"オニツカ側が、"
],
[
190.397,
